@misc{gilleland_extremes_2025,
	title = {{extRemes}: {Extreme} {Value} {Analysis}},
	shorttitle = {{extRemes}},
	url = {https://CRAN.R-project.org/package=extRemes},
	doi = {10.1175/JTECH-D-20-0070.1},
	abstract = {General functions for performing extreme value analysis.  In particular, allows for inclusion of covariates into the parameters of the extreme-value distributions, as well as estimation through MLE, L-moments, generalized (penalized) MLE (GMLE), as well as Bayes.  Inference methods include parametric normal approximation, profile-likelihood, Bayes, and bootstrapping.  Some bivariate functionality and dependence checking (e.g., auto-tail dependence function plot, extremal index estimation) is also included.  For a tutorial, see Gilleland and Katz (2016) {\textless}doi: 10.18637/jss.v072.i08{\textgreater} and for bootstrapping, please see Gilleland (2020) {\textless}doi: 10.1175/JTECH-D-20-0070.1{\textgreater}.},
	language = {en},
	urldate = {2025-07-01},
	author = {Gilleland, Eric},
	month = {may},
	year = {2025},
	note = {Institution: Comprehensive R Archive Network
Pages: 2.2-1}
}

